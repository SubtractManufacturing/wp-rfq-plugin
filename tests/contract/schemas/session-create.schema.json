{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session-create.schema.json",
  "type": "object",
  "required": ["session_id", "token"],
  "properties": {
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "token": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
