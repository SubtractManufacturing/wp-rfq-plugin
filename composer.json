{
  "name": "subtract-manufacturing/rfq-intake",
  "description": "RFQ Intake WordPress plugin",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.3",
    "aws/aws-sdk-php": "^3.386",
    "firebase/php-jwt": "^7.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "yoast/phpunit-polyfills": "^4.0"
  },
  "scripts": {
    "test": "phpunit -c phpunit.unit.xml.dist",
    "test:integration": "npm run test:integration"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.3.0"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
