{
  "name": "wp-rfq-plugin",
  "version": "1.0.0",
  "private": true,
  "description": "Plugin to handle RFQ ingest for WP sites with Subtract Custom Software.",
  "main": "index.js",
  "scripts": {
    "presandcastle": "node scripts/patch-sandcastle-docker-security.mjs && node scripts/patch-cursor-agent-win32.mjs",
    "sandcastle": "tsx .sandcastle/main.ts",
    "sandcastle:docker": "set SANDCASTLE_SANDBOX=docker&& tsx .sandcastle/main.ts",
    "sandcastle:legacy": "set SANDCASTLE_IMPLEMENT=codex&& set SANDCASTLE_REVIEW=cursor&& set SANDCASTLE_REVIEW_MODEL=composer-2.5-fast&& tsx .sandcastle/main.ts",
    "sandcastle:review": "tsx .sandcastle/review-branch.ts",
    "sandcastle:wsl": "wsl -e bash -lc \"cd \\\"$(wslpath -a '%CD%')\\\" && npm run sandcastle\"",
    "sandcastle:build-image": "sandcastle docker build-image",
    "sandcastle:fix-ci": "tsx .sandcastle/fix-ci.ts",
    "sandcastle:cleanup": "tsx .sandcastle/cleanup.ts",
    "labels:create": "node scripts/create-labels.mjs",
    "test": "composer test",
    "test:integration": "wp-env run tests-cli --env-cwd=wp-content/rfq-plugin-root vendor/bin/phpunit -c phpunit.integration.xml.dist",
    "test:smoke": "bash scripts/smoke-rest.sh",
    "test:pre-merge": "bash scripts/test-pre-merge.sh",
    "test:pre-merge:automated": "bash scripts/test-pre-merge.sh --no-smoke",
    "test:acceptance-coverage": "php scripts/check-acceptance-coverage.php",
    "test:contract": "php scripts/validate-contract-schemas.php",
    "test:frontend": "npm --prefix frontend ci && npm --prefix frontend run lint && npm --prefix frontend run test",
    "test:e2e": "playwright test tests/e2e/specs/rfq-form.spec.ts",
    "test:a11y": "playwright test tests/e2e/specs/a11y.spec.ts",
    "test:package": "node scripts/test-plugin-package.mjs",
    "package:plugin": "node scripts/build-plugin-package.mjs",
    "dev:restore-s3": "bash scripts/restore-dev-s3-from-env.sh",
    "qa:upload-urls": "bash scripts/qa-upload-urls.sh",
    "qa:s3-upload": "bash scripts/qa-s3-upload.sh",
    "qa:s3-spike": "bash scripts/qa-s3-spike.sh",
    "qa:bucket-privacy": "bash scripts/qa-bucket-privacy.sh",
    "qa:staging-m3": "bash scripts/qa-staging-m3.sh",
    "qa:webhook-e2e": "bash scripts/qa-webhook-e2e.sh",
    "webhook:mock": "node scripts/ci-webhook-mock.mjs",
    "wp-env": "wp-env",
    "typecheck": "echo \"No TypeScript at repo root yet\" && exit 0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SubtractManufacturing/wp-rfq-plugin.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "bugs": {
    "url": "https://github.com/SubtractManufacturing/wp-rfq-plugin/issues"
  },
  "homepage": "https://github.com/SubtractManufacturing/wp-rfq-plugin#readme",
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.10.0",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1",
    "@wordpress/env": "^10.22.0",
    "adm-zip": "^0.5.18",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
