{
  "name": "wp-rfq-plugin",
  "version": "1.0.0",
  "description": "Plugin to handle RFQ ingest for WP sites with Subtract Custom Software.",
  "main": "index.js",
  "scripts": {
    "presandcastle": "node scripts/patch-sandcastle-docker-security.mjs && node scripts/patch-cursor-agent-win32.mjs",
    "sandcastle": "tsx .sandcastle/main.ts",
    "sandcastle:docker": "set SANDCASTLE_SANDBOX=docker&& tsx .sandcastle/main.ts",
    "sandcastle:legacy": "set SANDCASTLE_IMPLEMENT=codex&& set SANDCASTLE_REVIEW=cursor&& set SANDCASTLE_REVIEW_MODEL=composer-2.5-fast&& tsx .sandcastle/main.ts",
    "sandcastle:review": "tsx .sandcastle/review-branch.ts",
    "sandcastle:wsl": "wsl -e bash -lc \"cd \\\"$(wslpath -a '%CD%')\\\" && npm run sandcastle\"",
    "sandcastle:build-image": "sandcastle docker build-image",
    "sandcastle:fix-ci": "tsx .sandcastle/fix-ci.ts",
    "sandcastle:cleanup": "tsx .sandcastle/cleanup.ts",
    "labels:create": "node scripts/create-labels.mjs",
    "test": "composer test",
    "test:integration": "wp-env run tests-cli --env-cwd=wp-content/rfq-plugin-root vendor/bin/phpunit -c phpunit.integration.xml.dist",
    "wp-env": "wp-env",
    "typecheck": "echo \"No TypeScript at repo root yet\" && exit 0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SubtractManufacturing/wp-rfq-plugin.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/SubtractManufacturing/wp-rfq-plugin/issues"
  },
  "homepage": "https://github.com/SubtractManufacturing/wp-rfq-plugin#readme",
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.10.0",
    "@types/node": "^26.0.1",
    "@wordpress/env": "^10.22.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
