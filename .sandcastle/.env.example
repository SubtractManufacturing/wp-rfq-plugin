# Copy to .sandcastle/.env and fill in values. Never commit .env.

# Cursor API key — implementer + CI fixer (required for default stack)
CURSOR_API_KEY=

# GitHub personal access token
GH_TOKEN=

# --- Agent selection (defaults shown; uncomment to override) ---
# Implementer: Cursor Composer 2.5 on host (execution from scoped issues)
# SANDCASTLE_IMPLEMENT=cursor
# SANDCASTLE_IMPLEMENT_MODEL=composer-2.5

# Reviewer: Codex gpt-5.5 on host (quality gate; uses ~/.codex/auth.json)
# SANDCASTLE_REVIEW=codex
# SANDCASTLE_REVIEW_MODEL=gpt-5.5

# Sandbox (default host; Docker via npm run sandcastle:docker)
# SANDCASTLE_SANDBOX=host

# Legacy stack — Codex implement, Cursor review:
# SANDCASTLE_IMPLEMENT=codex
# SANDCASTLE_IMPLEMENT_MODEL=gpt-5.4
# SANDCASTLE_REVIEW=cursor
# SANDCASTLE_REVIEW_MODEL=composer-2.5-fast

# OPENAI_KEY=   # only for Codex API billing instead of subscription
