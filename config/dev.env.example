# Local wp-env S3 credentials (development only).
# Copy to config/dev.env.local and fill in values. Never commit dev.env.local.
#
# Legacy root .env / .env.local names are also supported by the restore script.
#
# CI: set RFQ_S3_* (or legacy S3_* / S3_BUCKET_NAME / S3_KEY_ID) as GitHub Actions
# repository secrets. pre-merge runs qa:s3-upload when all five are present.
#
# Recommended: use a dedicated dev/CI bucket (not production). Objects are deleted
# by qa:s3-upload after each run.

RFQ_S3_ENDPOINT=https://your-project.storage.supabase.co/storage/v1/s3
RFQ_S3_BUCKET=your-bucket-name
RFQ_S3_ACCESS_KEY_ID=your-access-key-id
RFQ_S3_REGION=your-region
RFQ_S3_SECRET_KEY=your-secret-access-key

# ERP webhook (optional — leave blank until ERP is ready).
# CI uses scripts/ci-webhook-mock.mjs instead of a real ERP endpoint.
# RFQ_ERP_WEBHOOK_URL=https://erp.example.com/rfq/import
# RFQ_ERP_WEBHOOK_SECRET=shared-hmac-secret
