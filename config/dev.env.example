# Local wp-env S3 credentials (development only).
# Copy to config/dev.env.local and fill in values. Never commit dev.env.local.
#
# Legacy root .env / .env.local names are also supported by the restore script.

RFQ_S3_ENDPOINT=https://your-project.storage.supabase.co/storage/v1/s3
RFQ_S3_BUCKET=your-bucket-name
RFQ_S3_ACCESS_KEY_ID=your-access-key-id
RFQ_S3_REGION=your-region
RFQ_S3_SECRET_KEY=your-secret-access-key
